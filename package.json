{
  "name": "prostore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "dotenv -e .env.local -- next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "npx prisma generate",
    "migrate:dev": "dotenv -e .env.local -- npx prisma migrate dev",
    "migrate:reset": "dotenv -e .env.local -- npx prisma migrate reset",
    "db:push": "dotenv -e .env.local -- npx prisma db push",
    "db:seed": "dotenv -e .env.local -- ts-node src/db/seed.ts",
    "db:studio": "dotenv -e .env.local -- npx prisma studio",
    "generate": "dotenv -e .env.local -- npx prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "email": "shx cp .env.local ./node_modules/react-email && email dev --dir src/lib/email --port 3001"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.2.2",
    "@paypal/react-paypal-js": "^8.9.2",
    "@prisma/client": "^6.19.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@react-email/components": "^1.0.1",
    "@react-email/render": "^2.0.0",
    "@stripe/react-stripe-js": "^5.4.0",
    "@stripe/stripe-js": "^8.5.2",
    "@types/uuid": "^10.0.0",
    "@uploadthing/react": "^7.3.3",
    "autoprefixer": "^10.4.21",
    "bcrypt-ts-edge": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.548.0",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "path": "^0.12.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-email": "^5.0.5",
    "react-hook-form": "^7.66.0",
    "react-icons": "^5.7.0",
    "react-is": "^19.2.0",
    "recharts": "^3.4.1",
    "resend": "^6.5.2",
    "slugify": "^1.6.6",
    "stripe": "^20.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "uploadthing": "^7.7.4",
    "vaul": "^1.1.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@react-email/preview-server": "^5.0.5",
    "@react-email/tailwind": "^2.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "postcss": "^8",
    "prisma": "^6.19.1",
    "shx": "^0.4.0",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
